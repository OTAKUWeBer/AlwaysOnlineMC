# ==========================================
# AlwaysOnlineMC - Configuration Template
# ==========================================

# Server Connection (Required)
SERVER_HOST=your-server.aternos.me
SERVER_PORT=25565

# Dynamic / Fallback Server (Useful for Aternos servers - leave empty if not used)
FALLBACK_HOST=your-dyn-ip.aternos.host
FALLBACK_PORT=25565

# Bot Account Settings
BOT_USERNAME=YumeVanguard
AUTH_MODE=offline
MC_VERSION=1.21.4

# Feature Toggles
ENABLE_CHAT=true
ENABLE_BANGLA_SLANG=true
ENABLE_BLOCK_PLACING=true

# Timezone for Console Logs (e.g. UTC, Asia/Dhaka, America/New_York)
TIMEZONE=Asia/Dhaka
